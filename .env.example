# AuraStream Environment Configuration Example
# Copy to .env for live cloud execution.
# (If omitted, AuraStream automatically operates in verified local offline cache mode).

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
PORT=8000
HOST=127.0.0.1
